{
  "name": "sldl-downloader",
  "productName": "SLDL Downloader",
  "version": "3.3.1",
  "description": "Download Spotify playlists via Soulseek and put them on a player",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --mac",
    "release": "tools/release.sh",
    "build-all": "electron-builder --mac --win --linux",
    "test": "node --test test/core.test.js",
    "shot": "electron test/shot.js",
    "cli": "node cli.js"
  },
  "author": "Jack M",
  "license": "MIT",
  "build": {
    "appId": "com.jackm.sldl-downloader",
    "files": [
      "**/*",
      "!resources/sldl",
      "!test/**",
      "!dist/**",
      "!build/entitlements.mac.plist"
    ],
    "extraResources": [
      {
        "from": "resources/sldl",
        "to": "sldl",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.music",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.icns",
      "extendInfo": {
        "NSAppleEventsUsageDescription": "SLDL Downloader adds your downloaded playlists to the Music app."
      },
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "dmg": {
      "title": "SLDL Downloader",
      "icon": "build/icon.icns"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "linux": {
      "target": "AppImage",
      "category": "Audio"
    },
    "asarUnpack": [
      "tools/**"
    ]
  },
  "devDependencies": {
    "electron": "^39.2.3",
    "electron-builder": "^26.0.12"
  },
  "bin": {
    "sldl-dl": "cli.js"
  },
  "dependencies": {
    "music-metadata": "^12.8.3"
  }
}
